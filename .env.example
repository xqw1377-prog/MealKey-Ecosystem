DATABASE_URL=sqlite:///./mealky.db
APP_ENV=dev
DEPLOYMENT_TIER=dev
STORESTATE_DAYS=7
# 生产环境可设置 API_TOKEN，前端/调用方需带 X-API-Token
API_TOKEN=
# 生产务必单独配置 JWT_SECRET，不要用默认值，密钥不入库、不进 git
JWT_SECRET=
JWT_ENFORCE_STORE_SCOPE=true

# CORS：逗号分隔。开发可写 * ；生产必须写完整 https 来源，禁止 *
CORS_ORIGINS=https://mealkey.cn,https://www.mealkey.cn

# 生产节律交给 Celery beat。compose 的 api 已设 MEALKEY_DISABLE_CLOCK=1
# 单容器无 beat 时才打开：MEALKEY_ENABLE_INPROCESS_CLOCK=1
# MEALKEY_DISABLE_CLOCK=1

# 可选错误上报；留空则不上报
SENTRY_DSN=
# 日志：空=生产 JSON / 开发文本；1 强制 JSON，0 强制文本
LOG_JSON=

# 种子客户对公转账（不走微信自动扣费）。留空则提示联系运营取账户。
SEED_BANK_PAYEE=
SEED_BANK_ACCOUNT=
SEED_BANK_NAME=

# If you enable Celery later
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
COMPETITION_COLLECTION_HOUR=7
COMPETITION_COLLECTION_MINUTE=30
DAILY_JOB_HOUR=8
DAILY_JOB_MINUTE=0

# 高德控制台分别创建 Web 服务 Key 与 Web 端（JS API）Key
# 注意：AMAP_JS_SECURITY_CODE 仅在 APP_ENV=dev 时通过 /public/config 返回
AMAP_WEB_SERVICE_KEY=
AMAP_JS_API_KEY=
AMAP_JS_SECURITY_CODE=

# 可选：持牌/已授权竞品数据供应商，响应格式见 README
COMPETITION_PARTNER_API_URL=
COMPETITION_PARTNER_API_TOKEN=

# 外卖平台经营数据对接（你的适配服务 URL，统一 JSON 契约见设置页 / README）
PLATFORM_CONNECTOR_URL=
PLATFORM_CONNECTOR_TOKEN=

# TEST-ADAPTER-01（DEV/TEST 日报夹具，默认关闭）。生产禁止。不是 DATA-AS-01，不可晋升为生产 Connector。
# DAILY_REPORT_TEST_ENABLED=0
# DAILY_REPORT_TEST_BASE_URL=

# ===== MealKey LLM Intelligent Engine（从主仓 Mealkey Ai 迁移；真实 Key 写本地 .env，勿提交）=====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_FLAGSHIP_MODEL=deepseek-v4-pro
DEEPSEEK_FAST_MODEL=deepseek-v4-flash
QWEN_API_KEY=
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_STRUCTURED_MODEL=qwen3.7-plus
QWEN_UTILITY_MODEL=qwen3.6-flash
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
KIMI_LONG_CONTEXT_MODEL=kimi-k3
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_USE_PURPOSE_POLICY=1
LLM_EMERGENCY_ENV_OVERRIDE=0

# Agent narrative LLM 开关（默认 0=关闭，agent 结论用规则引擎模板）。
# 设为 1 后，diagnosis/review/menu/growth 四个核心 agent 的总结会改用 LLM 重写，
# 更自然口语化；失败/超时会自动回退到规则引擎结论，不影响可用性。
MEALKY_AGENT_LLM=0
