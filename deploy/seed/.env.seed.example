# Seed Environment V1
# Copy to /opt/mealkey/docker/.env.seed and replace secrets before first start.

APP_ENV=seed
DEPLOYMENT_TIER=seed

# Explicit allowlist only. APP_ENV=seed is treated as non-dev.
CORS_ORIGINS=https://seed.example.com

# Independent secrets for seed environment.
API_TOKEN=replace-with-seed-api-token
JWT_SECRET=replace-with-independent-jwt-secret

# Postgres / Redis
POSTGRES_USER=mealky
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_DB=mealky
DATABASE_URL=postgresql+psycopg://mealky:replace-with-strong-db-password@postgres:5432/mealky
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Logging / runtime
LOG_JSON=1
WEB_CONCURRENCY=2
RUN_MIGRATIONS_ON_START=0
MEALKEY_DISABLE_CLOCK=1

# TEST-ADAPTER-01 only. Seed may enable for evidence verification.
DAILY_REPORT_TEST_ENABLED=1
DAILY_REPORT_TEST_BASE_URL=http://49.234.54.78:54321

# Bank transfer placeholders
SEED_BANK_PAYEE=
SEED_BANK_ACCOUNT=
SEED_BANK_NAME=

# LLM - set only if needed
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_FLAGSHIP_MODEL=deepseek-v4-pro
DEEPSEEK_FAST_MODEL=deepseek-v4-flash
QWEN_API_KEY=
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_STRUCTURED_MODEL=qwen3.7-plus
QWEN_UTILITY_MODEL=qwen3.6-flash
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
KIMI_LONG_CONTEXT_MODEL=kimi-k3
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# Team policy markers. Current code does not enforce these directly,
# but keep them here to make the seed boundary explicit.
ENABLE_MOCK=false
ENABLE_WRITEBACK=false
ENABLE_AUTHORIZED_SESSION=false
